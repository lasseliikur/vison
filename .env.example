# Copy to .env. Vision's brain runs on your Claude Code login: run `claude` once and sign in.

# What Vision calls you, and the objective shown on the HUD.
USER_NAME=
VISION_OBJECTIVE=Stay ahead of email, calendar and coursework

# Canvas: your school's Canvas address. No token needed: Vision opens a Chrome window and you
# sign in by hand. It asks again every CANVAS_SYNC_DAYS days.
CANVAS_BASE_URL=https://YOUR-SCHOOL.instructure.com
# CANVAS_SYNC_DAYS=7

# Google (Gmail + Calendar): the client ID and secret of your own Google Cloud "Desktop app"
# OAuth client. The README walks through creating it. Accounts are then added from the HUD.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Minutes between Scout patrols (the "anything new?" check). 0 turns patrols off.
VISION_PATROL_MINUTES=15

# Models. Defaults: Sonnet 5.5 for the brain and agents, Haiku 5.5 for the background patrol.
# VISION_MODEL=claude-sonnet-5-5
# VISION_SCOUT_MODEL=claude-sonnet-5-5
# VISION_PATROL_MODEL=claude-haiku-5-5

# Optional: ElevenLabs voice. Without a key Vision uses your browser's built-in voice.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# VISION_PORT=8787
